# Marvin .env 範本 —— 只列「程式碼真的有讀」的變數（AST 掃描 2026-09-27）。
# 等號右邊＝程式碼內建預設值；留空＝預設為空或未設。說明見 OPERATOR.md §1。
# ⚠️ 啟動包裝 run_bot.py（launchd）會用 os.environ 先設一批旗標，load_dotenv 不覆寫既有值
#    → 那批以 run_bot.py 為準（見 OPERATOR.md §2）。

# ─── 必填 ──────────────────────────────────────────────────────────
DISCORD_BOT_TOKEN=
# Gemini（LLM_PROVIDER=gemini 時 GOOGLE_API_KEY / GEMINI_API_KEY 至少一個，否則 bot 啟動即 raise）
GOOGLE_API_KEY=
GEMINI_API_KEY=
# 「主伺服器」ID：人物長期記憶、摘要、回憶查詢都寫死用這個 guild（見 ARCHITECTURE.md §6）
GUILD_ID=0

# ─── LLM：金鑰（有 key 的 provider 才會進 LLM Bus 池）──────────────
GROQ_API_KEY=
MISTRAL_API_KEY=
TOGETHER_API_KEY=
OPENROUTER_API_KEY=
# 付費兜底（免費池全失敗才用；有 daily/monthly USD cap，見 OPERATOR.md §5）
GEMINI_PAID_API_KEY=
GEMINI_CLEANER_API_KEY=
# Cerebras free tier 已於 2026-08-17 失效（呼叫回 402），llm_pool 已移除；router 仍會讀
CEREBRAS_API_KEY=
CEREBRAS_MODEL=llama-3.1-8b
# NemoClaw（openclaw CLI，owner 專用）
NVIDIA_API_KEY=

# ─── LLM：模型與路由 ───────────────────────────────────────────────
LLM_PROVIDER=gemini
LLM_MODEL=gemma-4-31b-it
LLM_PRIMARY_MODEL=gemma-4-31b-it
GROQ_SIMPLE_MODEL=openai/gpt-oss-20b
GROQ_FALLBACK_MODEL=openai/gpt-oss-120b
GEMINI_FLASH_MODEL=gemini-3.5-flash-lite
MARVIN_REVIEW_MODEL=gemini-3.5-flash-lite
# 各 provider 模型覆寫：{PROVIDER}_QUICK_MODEL / {PROVIDER}_ANALYZE_MODEL（Mistral 用下面兩個名字）
MISTRAL_QUICK_MODEL=
MISTRAL_MODEL=
# true = 所有 _call_llm 走 LLM Bus（多 provider 池）；prod 為 true
LLM_BUS=
# Gemini 主 key 每日 token 上限（超過即斷路）
MAX_DAILY_TOKENS=500000
# 只有 LLM_PROVIDER=ollama 才用；目前未使用
OLLAMA_BASE_URL=http://localhost:11434/v1

# ─── 身分 / 擁有者 ─────────────────────────────────────────────────
OWNER_SPEAKER=
MARVIN_OWNER_ID=
LOCAL_USER_ID=0
TEMP_TEXT_CHANNEL_ID=0
DISCORD_REVIEW_CHANNEL_ID=
# 走台語雲端 STT（雅婷）的 Discord user_id，逗號分隔；空＝沒人走
NAN_SPEAKER_IDS=

# ─── STT ───────────────────────────────────────────────────────────
# macos / mlx = Apple 平台（Swift STT）；其他值 = Linux（faster-whisper）
STT_ENGINE=macos
# SpeechAnalyzer v2 主力（run_bot.py 設 true）
STT_ENGINE_V2=
# true = 關掉 Groq Whisper 雲端備援（prod 為 true）
STT_SWIFT_STRICT=
STT_AUTO_DETECT_LANG=false
STT_LOCALE=zh-TW
# true = 每句話都存一份 records/stt_debug_*.wav（重度使用 ~700MB/天，保留 7 天）
STT_DEBUG_ARCHIVE=false
TTS_INTERRUPT_CONFIRM_FRAMES=3
YATING_API_KEY=
MLX_WHISPER_MODEL=mlx-community/whisper-base-mlx-8bit

# ─── TTS / 音量 ────────────────────────────────────────────────────
MARVIN_TTS_GAIN=1.0
MARVIN_TTS_BOOST=1.3
MARVIN_WAKE_DUCK=1
MARVIN_MUSIC_ECHO_GUARD=1

# ─── 音樂 ──────────────────────────────────────────────────────────
MARVIN_YT_COOKIES_FROM_BROWSER=chrome
MARVIN_YT_COOKIES_FILE=~/.config/marvin/youtube_cookies.txt
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
MARVIN_SPOTIFY_METADATA=1
MARVIN_ITUNES_COVER=1
MARVIN_HIGHLIGHT_START=1
YOUTUBE_API_KEY=
MARVIN_MUSIC_FASTPATH=
MARVIN_REQUEST_PRIORITY=1
MARVIN_STATE_PICK=
ASSOCIATIVE_CURATION=on
LLM_TASTE_T2=off
MARVIN_COLLECT_SONG_VOICE_SAMPLES=

# ─── 意圖 / 行為旗標 ───────────────────────────────────────────────
MARVIN_COMMAND_FASTPATH=1
MARVIN_ETD_CLEAN_REUSE=1
MARVIN_CLEANER_COLD_PAID=1
MARVIN_INTENT_RESCUE_ENABLED=
MARVIN_INTENT_RESCUE_SHADOW=
MARVIN_INTENT_RESCUE_MODE=
MARVIN_PER_SPEAKER_QUEUE=0
MARVIN_FOLLOWUP_ENABLED=true
MARVIN_FOLLOWUP_WINDOW_SEC=8.0
MARVIN_REACTION_CHECK_RATE=0.1
MARVIN_MEMORY_QUARANTINE=1
SPEAK_MEMORY_CALLBACK=
SPONTANEOUS_MANZAI=
MARVIN_NEWS_BROADCAST=1
MARVIN_AUTO_REJOIN=1
MARVIN_INTIMATE_MODE=
CALLBACK_ON_JOIN=
NEMOCLAW_COVER=
# 1 = 保存 owner 喊「馬文」的原始 wav 到 records/wake_samples/（只存 MARVIN_OWNER_ID 本人）
MARVIN_COLLECT_WAKE_WAV=
MEMORY_GUARD_THRESHOLD_PCT=92.0

# ─── 外部橋接（只綁 127.0.0.1）───────────────────────────────────────
MARMO_PORT=8765
MARMO_TOKEN=
MARMO_VOICE=
MARMO_DUAL_SPEAK=
MARMO_DUAL_CHANCE=0.5

# ─── 維運 / Log ────────────────────────────────────────────────────
MARVIN_HEARTBEAT=1
MARVIN_HEARTBEAT_PROBE=1
MARVIN_FUNNEL_HEALTHCHECK=1
MARVIN_WATCHDOG_WEBHOOK=
STDOUT_LOG_MAX_MB=5
STDOUT_LOG_BACKUPS=3
DEBUG_AUDIO_PACKETS=false
DEBUG_UDP_HEARTBEAT=false
DEBUG_VAD_HEARTBEAT=false

# ─── 衛星 / 車用 / 本機模式（main_satellite.py、main_local.py；Discord bot 不需要）──
MARVIN_SATELLITE_HOST=marvinpi.local
MARVIN_SATELLITE_SPEAKER=
MARVIN_SATELLITE_BROWSER=
MARVIN_SATELLITE_LOWBW=
MARVIN_SATELLITE_MIC_BRIDGE=1
MARVIN_SATELLITE_SELFTEST_MP3=
MARVIN_SATELLITE_SELFTEST_QUERY=
MARVIN_LOCAL_SPEAKER=
MARVIN_CAR_MODE=
MARVIN_CAR_HARDWARE=
MARVIN_TEXT_PORT=8790
MARVIN_TEXT_TOKEN=
MARVIN_AUDIO_STREAM_BATCH_MS=100
MARVIN_AUDIO_STREAM_MP3_KBPS=128
MARVIN_CLAUDE_STATUS_SCAN=1
MARVIN_PERFORMANCE_SCRIPT=1
MARVIN_PERFORMANCE_THEME=matrix
MARVIN_HUD_STREAM_PORT=8791
MARVIN_HUD_STREAM_INTERVAL=0.1

# ─── Pi 端（device/*.py，設在 Raspberry Pi 上，不是這台 Mac）─────────
# MARVIN_MAC_BASE_URL= MARVIN_MAC_SAY_URL= MARVIN_MAC_TOKEN= MARVIN_VOL_PORT=8766
# MARVIN_VOL_TOKEN= MARVIN_VOL_CARD=IQaudIODAC MARVIN_VOL_CONTROL=Digital MARVIN_AVRCP_ENABLE=1
# MARVIN_PUCK_BT_MAC= MARVIN_PUCK_BT_MAC_FALLBACK= MARVIN_PUCK_MIC_DEVICE= MARVIN_PUCK_MIC_AEC_OUT=
# MARVIN_PUCK_NULL_SINK= MARVIN_PUCK_LOCAL_STATUS_AUDIO= MARVIN_PUCK_LOCAL_HOTSPOT_FAILED_AUDIO=
